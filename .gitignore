# https://git-scm.com/docs/gitignore
# https://help.github.com/articles/ignoring-files
# Example .gitignore files: https://github.com/github/gitignore
/bower_components/
/node_modules/

# Runtime data (recorded streams, generated broadcast key)
/data/

# Generated at server start by tools/make-icons.mjs (deterministic)
/public/icons/*.png

# TLS material
*.pem
*.key
*.crt

# Test scratch
/test/.tmp/
